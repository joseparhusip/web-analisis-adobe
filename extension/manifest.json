{
  "manifest_version": 3,
  "name": "Stock Research Companion",
  "version": "1.2.0",
  "description": "Mencatat jumlah hasil dan aset terlaris dari halaman pencarian Adobe Stock yang kamu buka ke aplikasi Stock Research.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "https://*.ngrok-free.app/*", "https://*.ngrok.app/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://stock.adobe.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
